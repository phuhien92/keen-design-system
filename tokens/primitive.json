{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "primitive": {
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
      "gray-50": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.9569, 0.9686], "hex": "#F2F4F7" } },
      "gray-100": { "$value": { "colorSpace": "srgb", "components": [0.8941, 0.9059, 0.9255], "hex": "#E4E7EC" } },
      "gray-300": { "$value": { "colorSpace": "srgb", "components": [0.6392, 0.6706, 0.7216], "hex": "#A3ABB8" } },
      "gray-400": { "$value": { "colorSpace": "srgb", "components": [0.4784, 0.5137, 0.5804], "hex": "#7A8394" } },
      "gray-500": { "$value": { "colorSpace": "srgb", "components": [0.4314, 0.4667, 0.5294], "hex": "#6E7787" } },
      "gray-600": { "$value": { "colorSpace": "srgb", "components": [0.2784, 0.3294, 0.4039], "hex": "#475467" } },
      "gray-800": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.1686, 0.2078], "hex": "#262B35" } },
      "gray-850": { "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1608], "hex": "#1C2029" } },
      "gray-900": { "$value": { "colorSpace": "srgb", "components": [0.0627, 0.0941, 0.1569], "hex": "#101828" } },
      "gray-950": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0667, 0.0824], "hex": "#0F1115" } },
      "blue-200": { "$value": { "colorSpace": "srgb", "components": [0.6431, 0.7451, 1], "hex": "#A4BEFF" } },
      "blue-300": { "$value": { "colorSpace": "srgb", "components": [0.5255, 0.6588, 1], "hex": "#86A8FF" } },
      "blue-600": { "$value": { "colorSpace": "srgb", "components": [0.1451, 0.3412, 0.8392], "hex": "#2557D6" } },
      "blue-700": { "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1D4ED8" } },
      "blue-950": { "$value": { "colorSpace": "srgb", "components": [0.0431, 0.0627, 0.1255], "hex": "#0B1020" } },
      "red-50": { "$value": { "colorSpace": "srgb", "components": [0.9961, 0.9529, 0.949], "hex": "#FEF3F2" } },
      "red-300": { "$value": { "colorSpace": "srgb", "components": [1, 0.6118, 0.5804], "hex": "#FF9C94" } },
      "red-700": { "$value": { "colorSpace": "srgb", "components": [0.7059, 0.1373, 0.0941], "hex": "#B42318" } },
      "red-950": { "$value": { "colorSpace": "srgb", "components": [0.1686, 0.0902, 0.0902], "hex": "#2B1717" } },
      "amber-50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9804, 0.9216], "hex": "#FFFAEB" } },
      "amber-400": { "$value": { "colorSpace": "srgb", "components": [0.9922, 0.6902, 0.1333], "hex": "#FDB022" } },
      "amber-700": { "$value": { "colorSpace": "srgb", "components": [0.7098, 0.2784, 0.0314], "hex": "#B54708" } },
      "amber-950": { "$value": { "colorSpace": "srgb", "components": [0.1686, 0.1294, 0.0784], "hex": "#2B2114" } }
    }
  },
  "space": {
    "$type": "dimension",
    "primitive": {
      "sm": { "$value": { "value": 8, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "primitive": {
      "md": { "$value": { "value": 8, "unit": "px" } },
      "lg": { "$value": { "value": 12, "unit": "px" } },
      "xl": { "$value": { "value": 16, "unit": "px" } }
    }
  },
  "font": {
    "primitive": {
      "family-inter": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "weight-semibold": { "$type": "fontWeight", "$value": 600 },
      "size-13": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
      "size-15": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
      "size-16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "line-height-150": { "$type": "number", "$value": 1.5 }
    }
  }
}
