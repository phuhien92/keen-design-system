{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "semantic": {
      "surface": {
        "$value": "{color.primitive.white}",
        "$description": "Main background of panels and controls. Pairs with text-primary and text-subtle.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.gray-950}" } } }
      },
      "surface-raised": {
        "$value": "{color.primitive.gray-50}",
        "$description": "Background a step above surface: assistant messages, suggestions, and the rate-limit notice.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.gray-850}" } } }
      },
      "text-primary": {
        "$value": "{color.primitive.gray-900}",
        "$description": "Body text on surface, surface-raised, danger-surface, and warning-surface.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.gray-50}" } } }
      },
      "text-subtle": {
        "$value": "{color.primitive.gray-600}",
        "$description": "Secondary text: placeholders, status, empty body. Still meets 4.5:1 on surface and surface-raised.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.gray-300}" } } }
      },
      "border": {
        "$value": "{color.primitive.gray-100}",
        "$description": "Decorative dividers and outlines that are not needed to identify a control.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.gray-800}" } } }
      },
      "border-strong": {
        "$value": "{color.primitive.gray-400}",
        "$description": "Control boundaries that identify an input or button. Meets 3:1 on surface.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.gray-500}" } } }
      },
      "action": {
        "$value": "{color.primitive.blue-600}",
        "$description": "Primary action fill, such as Send. Pairs with text-on-action.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.blue-300}" } } }
      },
      "text-on-action": {
        "$value": "{color.primitive.white}",
        "$description": "Text and icons on action fills.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.blue-950}" } } }
      },
      "focus": {
        "$value": "{color.primitive.blue-700}",
        "$description": "Focus ring. Meets 3:1 on surface.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.blue-200}" } } }
      },
      "danger": {
        "$value": "{color.primitive.red-700}",
        "$description": "Error text, icons, and outlines. Meets 4.5:1 on danger-surface.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.red-300}" } } }
      },
      "danger-surface": {
        "$value": "{color.primitive.red-50}",
        "$description": "Background of error notices.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.red-950}" } } }
      },
      "warning": {
        "$value": "{color.primitive.amber-700}",
        "$description": "Warning text, icons, and dividers, such as the offline banner's. Meets 4.5:1 on warning-surface.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.amber-400}" } } }
      },
      "warning-surface": {
        "$value": "{color.primitive.amber-50}",
        "$description": "Background of warning banners.",
        "$extensions": { "keen": { "modes": { "dark": "{color.primitive.amber-950}" } } }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "semantic": {
      "inset-sm": {
        "$value": "{space.primitive.sm}",
        "$description": "Compact padding: vertical bubble padding, chips, field trailing edge."
      },
      "inset-md": {
        "$value": "{space.primitive.md}",
        "$description": "Default padding inside surfaces: panel sections and horizontal bubble padding."
      },
      "gap-sm": {
        "$value": "{space.primitive.sm}",
        "$description": "Gap between items in a row or a short stack."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "semantic": {
      "control": {
        "$value": "{radius.primitive.md}",
        "$description": "Corner radius of inputs, buttons, chips, and notices."
      },
      "container": {
        "$value": "{radius.primitive.lg}",
        "$description": "Corner radius of panels."
      }
    }
  },
  "font": {
    "semantic": {
      "family-body": {
        "$type": "fontFamily",
        "$value": "{font.primitive.family-inter}",
        "$description": "Typeface for all chat text."
      },
      "weight-strong": {
        "$type": "fontWeight",
        "$value": "{font.primitive.weight-semibold}",
        "$description": "Weight for titles and button labels."
      },
      "size-body": {
        "$type": "dimension",
        "$value": "{font.primitive.size-15}",
        "$description": "Message and input text size."
      },
      "size-caption": {
        "$type": "dimension",
        "$value": "{font.primitive.size-13}",
        "$description": "Status lines, notices, chips, and button labels."
      },
      "size-title": {
        "$type": "dimension",
        "$value": "{font.primitive.size-16}",
        "$description": "Header title and empty-state title."
      },
      "line-height-body": {
        "$type": "number",
        "$value": "{font.primitive.line-height-150}",
        "$description": "Line height multiplier for message text."
      }
    }
  }
}
