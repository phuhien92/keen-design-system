{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuhien92/keen-design-system/docs/components/component-contract.schema.json",
  "title": "Keen Component Contract",
  "description": "Minimal schema for a Keen Component Contract. contract.mjs validates it with a built-in subset validator (only the keywords used here) and adds the cross-checks a schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "contractVersion", "status", "summary", "design", "boundary", "states", "transitions", "anatomy", "api", "overrides", "bindings", "contrast", "structure", "keyboard", "focus", "screenReader"],
  "properties": {
    "$schema": { "type": "string" },
    "component": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
    "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["proposed", "approved", "deprecated"] },
    "summary": { "$ref": "#/$defs/text" },
    "design": {
      "type": "object", "additionalProperties": false, "required": ["source", "note"],
      "properties": { "source": { "$ref": "#/$defs/path" }, "note": { "$ref": "#/$defs/text" } }
    },
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["keen", "host"],
      "properties": { "keen": { "$ref": "#/$defs/texts" }, "host": { "$ref": "#/$defs/texts" } }
    },
    "states": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "description", "composer", "partialResponse", "announcement", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/text" },
        "composer": { "enum": ["send", "stop", "send-disabled", "notice"] },
        "partialResponse": { "enum": ["none", "growing", "kept", "unchanged"] },
        "announcement": { "$ref": "#/$defs/text" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } }
      }
    } },
    "transitions": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["from", "event", "to"],
      "properties": { "from": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } }, "event": { "$ref": "#/$defs/text" }, "to": { "description": "A state name, or previous: the state that was active when the from state was entered.", "$ref": "#/$defs/name" } }
    } },
    "anatomy": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["part", "element", "description"],
      "examples": [
        { "part": "send", "element": "button[type=submit]", "description": "Sends the draft." },
        { "part": "input", "element": "textarea", "description": "Message input.", "elements": [{ "name": "field", "description": "The bordered field around the textarea." }] },
        { "part": "live-region", "element": "div[aria-live=polite]", "drawn": false, "description": "Announcements; not visible." }
      ],
      "properties": {
        "part": { "$ref": "#/$defs/name" },
        "element": { "type": "string" },
        "slot": { "type": "boolean" },
        "drawn": { "description": "false for a part the design does not draw, such as a live region.", "type": "boolean" },
        "description": { "$ref": "#/$defs/text" },
        "elements": { "description": "Named elements inside the part that bindings style separately.", "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "description"],
          "properties": { "name": { "$ref": "#/$defs/name" }, "description": { "$ref": "#/$defs/text" } }
        } }
      }
    } },
    "api": {
      "type": "object", "additionalProperties": false, "required": ["types", "props", "labels", "behavior"],
      "properties": {
        "types": { "$ref": "#/$defs/texts" },
        "props": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "type", "description"],
          "properties": { "name": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" }, "type": { "type": "string" }, "required": { "type": "boolean" }, "default": { "type": "string" }, "description": { "$ref": "#/$defs/text" } }
        } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "behavior": { "$ref": "#/$defs/texts" }
      }
    },
    "overrides": {
      "type": "object", "additionalProperties": false, "required": ["componentTokens", "variants", "slots", "note"],
      "properties": {
        "componentTokens": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "variants": { "type": "array", "items": { "type": "object" } },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "bindings": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["part", "property", "token"],
      "description": "One CSS property of one part or element, in one state. Never a token value, and never several properties in one binding.",
      "examples": [
        { "part": "send", "property": "background", "token": "color.semantic.action" },
        { "part": "input", "element": "field", "property": "border-color", "state": "focus", "token": "color.semantic.focus" },
        { "part": "input", "element": "field", "property": "padding-block", "token": "space.semantic.inset-sm", "drawn": false }
      ],
      "properties": {
        "part": { "$ref": "#/$defs/name" },
        "element": { "description": "An element of the part, from its anatomy entry. Omitted when the binding styles the part itself.", "$ref": "#/$defs/name" },
        "property": { "description": "A CSS property, or divider-color for a one-sided border.", "enum": ["background", "color", "border-color", "divider-color", "radius", "padding", "padding-block", "padding-block-start", "padding-block-end", "padding-inline", "padding-inline-start", "padding-inline-end", "gap", "max-width", "min-height", "width", "height", "font-family", "font-size", "font-weight", "line-height"] },
        "state": { "description": "The interaction state the binding applies in. Omitted for the resting state.", "enum": ["hover", "focus", "pressed", "disabled", "placeholder"] },
        "token": { "$ref": "#/$defs/token" },
        "drawn": { "description": "false when the design cannot draw the binding, such as padding the design replaces with a fixed height.", "type": "boolean" }
      }
    } },
    "contrast": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["foreground", "background", "minimum"],
      "properties": { "foreground": { "$ref": "#/$defs/token" }, "background": { "$ref": "#/$defs/token" }, "minimum": { "type": "number" } }
    } },
    "structure": { "$ref": "#/$defs/texts" },
    "keyboard": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["keys", "where", "action"],
      "properties": { "keys": { "type": "string" }, "where": { "type": "string" }, "action": { "$ref": "#/$defs/text" } }
    } },
    "focus": { "$ref": "#/$defs/texts" },
    "screenReader": { "$ref": "#/$defs/texts" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "token": {
      "description": "Tier-in-name token path: category.semantic.role or component.property. Primitives are not allowed in a contract.",
      "type": "string",
      "pattern": "^([a-z]+\\.semantic\\.[a-z0-9-]+|[a-z]+\\.[a-z0-9-]+)$"
    }
  }
}
