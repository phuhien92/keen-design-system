{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Colors for the design canvas only: annotations and state frames in design/keen.pen. They are written into the Pen variables and never reach the CSS, the typed token map, or the baseline.",
  "canvas": {
    "$type": "color",
    "frame-background": {
      "$value": { "colorSpace": "srgb", "components": [0.9098, 0.9216, 0.9412], "hex": "#E8EBF0" },
      "$description": "Background of each state frame around a mockup.",
      "$extensions": { "keen": { "modes": { "dark": { "colorSpace": "srgb", "components": [0.102, 0.1137, 0.1412], "hex": "#1A1D24" } } } }
    },
    "annotation-label": {
      "$value": { "colorSpace": "srgb", "components": [0.2902, 0.3255, 0.3804], "hex": "#4A5361" },
      "$description": "State index and intent keys beside a mockup.",
      "$extensions": { "keen": { "modes": { "dark": { "colorSpace": "srgb", "components": [0.6392, 0.6706, 0.7216], "hex": "#A3ABB8" } } } }
    },
    "annotation-title": {
      "$value": { "colorSpace": "srgb", "components": [0.0627, 0.0941, 0.1569], "hex": "#101828" },
      "$description": "State title beside a mockup.",
      "$extensions": { "keen": { "modes": { "dark": { "colorSpace": "srgb", "components": [0.949, 0.9569, 0.9686], "hex": "#F2F4F7" } } } }
    },
    "annotation-summary": {
      "$value": { "colorSpace": "srgb", "components": [0.2039, 0.251, 0.3294], "hex": "#344054" },
      "$description": "State summary beside a mockup.",
      "$extensions": { "keen": { "modes": { "dark": { "colorSpace": "srgb", "components": [0.8157, 0.8353, 0.8667], "hex": "#D0D5DD" } } } }
    },
    "annotation-text": {
      "$value": { "colorSpace": "srgb", "components": [0.1137, 0.1608, 0.2235], "hex": "#1D2939" },
      "$description": "Intent text beside a mockup: focus, keyboard, and announcement notes.",
      "$extensions": { "keen": { "modes": { "dark": { "colorSpace": "srgb", "components": [0.8157, 0.8353, 0.8667], "hex": "#D0D5DD" } } } }
    }
  }
}
