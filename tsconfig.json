{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "jsx": "react-jsx"
  },
  "include": ["tools/*/src", "tools/*/test", "packages/*/src", "packages/*/tests", "vitest.config.ts"]
}
